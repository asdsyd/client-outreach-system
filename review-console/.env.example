# Local preview only. Demo mode never contacts n8n.
OUTREACH_DEMO_MODE=true
OUTREACH_DEMO_USER_NAME=Demo reviewer
OUTREACH_DEMO_USER_EMAIL=demo@local.invalid

# ChatGPT-authenticated reviewers allowed to read and mutate the live queue.
OUTREACH_REVIEWER_EMAILS=reviewer@example.com

# n8n public API. Use a dedicated key limited to Data Table scopes when available.
N8N_BASE_URL=https://n8n.example.com/api/v1
N8N_REVIEW_API_KEY=
N8N_REQUEST_TIMEOUT_MS=10000

# Optional. If omitted, the adapter resolves these exact table names:
# outreach_review_queue_v3, outreach_batches_v3, outreach_batch_items_v3
N8N_REVIEW_QUEUE_TABLE_ID=
N8N_REVIEW_BATCHES_TABLE_ID=
N8N_REVIEW_BATCH_ITEMS_TABLE_ID=

# Fail-closed send snapshot shown in the final confirmation.
OUTREACH_SEND_MODE=TEST
OUTREACH_SENDER_NAME=Demo Sender
OUTREACH_SENDER_EMAIL=outreach@example.com
OUTREACH_REPLY_TO=outreach@example.com
OUTREACH_TEST_RECIPIENT=internal-test@example.com
OUTREACH_MAX_BATCH_SIZE=1
OUTREACH_PACING_SECONDS=90
OUTREACH_SENDER_DOMAIN_AUTHENTICATED=false
OUTREACH_PILOT_COMPLETE=false
